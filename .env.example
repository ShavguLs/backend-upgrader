PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upgrader?schema=public
FRONTEND_URL=http://localhost:3001

STEAM_API_KEY=your_steam_api_key
STEAM_REALM=http://localhost:3000/
STEAM_RETURN_URL=http://localhost:3000/auth/steam/return
SESSION_SECRET=change-this-long-random-secret
# Set to true only for local/dev auth testing.
ENABLE_DEV_LOGIN=false

# Plisio Deposits
PLISIO_SECRET_KEY=your_plisio_secret_key
PUBLIC_BACKEND_URL=http://localhost:3000
MIN_DEPOSIT_RUB=100
PLISIO_SOURCE_CURRENCY=RUB

# Virtual Skins
SKIN_SELLBACK_PERCENT=90
SKIN_PRICE_MARKUP_PERCENT=8
SKIN_MIN_PRICE_RUB=10
SKIN_PROVIDER=WAXPEER
SKIN_SYNC_INTERVAL_SECONDS=300
SKIN_STALE_AFTER_MINUTES=30

# Waxpeer
WAXPEER_API_KEY=your_waxpeer_api_key
WAXPEER_API_BASE_URL=https://api.waxpeer.com
WAXPEER_PRICES_PATH=/v1/prices

# Waxpeer Withdrawals
# Real withdrawals spend real Waxpeer balance. Do not enable in local/dev
# without intent; leave WAXPEER_API_KEY unset to disable the feature.
WAXPEER_WITHDRAW_GAME=csgo
WAXPEER_WITHDRAW_POLL_SECONDS=60
WAXPEER_WITHDRAW_TIMEOUT_MINUTES=30
# Grace period after a buy where the poller will not auto-restore on
# missing/unknown project id. Protects against Waxpeer-indexing races.
WAXPEER_RECOVERY_GRACE_SECONDS=60
# When WAXPEER_API_KEY is unset, the trade URL save endpoint normally
# refuses to verify trade URLs. Set this to "true" only for local dev
# to allow saving a syntactically-valid trade URL without remote verification.
ALLOW_UNVERIFIED_TRADE_URL=false

# FX
USD_RUB_RATE=90
FX_RATE_API_URL=https://open.er-api.com/v6/latest/USD
FX_RATE_CACHE_SECONDS=3600

# Upgrader Game
# Hidden house edge applied to displayed chances. If a user sees 50% and
# UPGRADER_HOUSE_EDGE_PERCENT=10, the backend rolls with 45%. Must be >= 0
# and < 100. Frontend responses only expose the displayed chance.
UPGRADER_HOUSE_EDGE_PERCENT=10
UPGRADER_MIN_DISPLAYED_CHANCE_PERCENT=1
UPGRADER_MAX_DISPLAYED_CHANCE_PERCENT=75
# Tolerance (percent) used to find target skins around the calculated
# target price for the chance-tier options grid.
UPGRADER_TARGET_PRICE_TOLERANCE_PERCENT=15
