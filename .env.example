PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/upgrader?schema=public
FRONTEND_URL=http://localhost:3001

STEAM_API_KEY=your_steam_api_key
STEAM_REALM=http://localhost:3000/
STEAM_RETURN_URL=http://localhost:3000/auth/steam/return
SESSION_SECRET=change-this-long-random-secret
# Set to true only for local/dev auth testing.
ENABLE_DEV_LOGIN=false

# Plisio Deposits
PLISIO_SECRET_KEY=your_plisio_secret_key
PUBLIC_BACKEND_URL=http://localhost:3000
MIN_DEPOSIT_RUB=100
PLISIO_SOURCE_CURRENCY=RUB

# Virtual Skins
SKIN_SELLBACK_PERCENT=90
SKIN_PRICE_MARKUP_PERCENT=8
SKIN_PROVIDER=WAXPEER
SKIN_SYNC_INTERVAL_SECONDS=300
SKIN_STALE_AFTER_MINUTES=30

# Waxpeer
WAXPEER_API_KEY=your_waxpeer_api_key
WAXPEER_API_BASE_URL=https://api.waxpeer.com
WAXPEER_PRICES_PATH=/v1/prices

# FX
USD_RUB_RATE=90
FX_RATE_API_URL=https://open.er-api.com/v6/latest/USD
FX_RATE_CACHE_SECONDS=3600
