// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int                    @id @default(autoincrement())
  email                   String?                @unique
  steamId                 String                 @unique
  displayName             String
  avatar                  String?
  profileUrl              String?
  steamTradeUrl           String?
  steamTradePartner       String?
  steamTradeToken         String?
  steamTradeUrlVerifiedAt DateTime?
  wallet                  Wallet?
  deposits                Deposit[]
  inventoryItems          InventoryItem[]
  inventoryTransactions   InventoryTransaction[]
  withdrawalRequests      WithdrawalRequest[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
}

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("RUB")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Deposit {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderNumber     String    @unique
  amountRub       Decimal   @db.Decimal(18, 2)
  sourceCurrency  String    @default("RUB")
  paymentCurrency String?
  plisioTxnId     String?   @unique
  invoiceUrl      String?
  status          String    @default("created")
  creditedAt      DateTime?
  rawCallback     Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Skin {
  id              Int             @id @default(autoincrement())
  marketHashName  String          @unique
  name            String
  weapon          String?
  category        String?
  rarity          String?
  exterior        String?
  imageUrl        String?
  priceRub        Decimal         @db.Decimal(18, 2)
  provider        String?
  providerItemId  String?
  providerRawData Json?
  lastSyncedAt    DateTime?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  inventoryItems  InventoryItem[]

  @@index([isActive, priceRub])
  @@index([weapon])
  @@index([rarity])
  @@index([exterior])
}

model InventoryItem {
  id               Int                    @id @default(autoincrement())
  userId           Int
  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  skinId           Int
  skin             Skin                   @relation(fields: [skinId], references: [id])
  purchasePriceRub Decimal                @db.Decimal(18, 2)
  sellPriceRub     Decimal                @db.Decimal(18, 2)
  status           String                 @default("owned")
  source           String                 @default("purchase")
  metadata         Json?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  transactions     InventoryTransaction[]
  withdrawalRequests WithdrawalRequest[]

  @@index([userId, status])
  @@index([skinId])
}

model WithdrawalRequest {
  id                Int           @id @default(autoincrement())
  userId            Int
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItemId   Int
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])
  status            String        @default("created")
  provider          String        @default("waxpeer")
  providerProjectId String        @unique
  providerTradeId   String?
  providerListingId String?
  providerPrice     Int?
  providerStatus    Int?
  steamTradeUrl     String
  errorMessage      String?
  providerRawData   Json?
  requestedAt       DateTime      @default(now())
  lastCheckedAt     DateTime?
  completedAt       DateTime?
  failedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, status])
  @@index([inventoryItemId])
  @@index([status, lastCheckedAt])
}

model InventoryTransaction {
  id              Int            @id @default(autoincrement())
  userId          Int
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  inventoryItemId Int?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  type            String
  amountRub       Decimal        @db.Decimal(18, 2)
  metadata        Json?
  createdAt       DateTime       @default(now())

  @@index([userId, createdAt])
  @@index([inventoryItemId])
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
